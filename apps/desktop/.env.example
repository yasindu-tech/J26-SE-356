# Copy to .env for local development.
# Backend API origin — also injected into the renderer's CSP connect-src
# (see src/renderer/index.html), so it must be an exact origin, not a path.
VITE_API_BASE_URL=http://localhost:8000

# Optional: the Python that runs the finger-tapping demo (Streamlit). Read by the main process
# only (MAIN_VITE_ prefix). Unset = <repo root>/.venv/bin/python (Windows: .venv\Scripts\python.exe).
MAIN_VITE_TAPPING_PYTHON=
